            padx=5
        )


        # =========================
        # DISASTER BUTTONS
        # =========================

        buttons = tk.Frame(
            self
        )

        buttons.pack(
            pady=5
        )

        for disaster in disasters:

            tk.Button(
                buttons,
                text=disaster,
                width=12,
                command=lambda d=disaster: self.show_disaster(d)
            ).pack(
                side="left",
                padx=4
            )


        # =========================
        # SCROLL AREA
        # =========================

        area = tk.Frame(
            self
        )

        area.pack(
            fill="both",
            expand=True,
            padx=40,
            pady=10
        )

        self.canvas = tk.Canvas(
            area,
            highlightthickness=0
        )

        scrollbar = tk.Scrollbar(
            area,
            orient="vertical",
            command=self.canvas.yview
        )

        self.info = tk.Frame(
            self.canvas
        )

        self.canvas_window = self.canvas.create_window(
            (0, 0),
            window=self.info,
            anchor="nw"
        )

        self.info.bind(
            "<Configure>",
            self.update_scroll
        )

        self.canvas.bind(
            "<Configure>",
            self.resize_info
        )

        self.canvas.configure(
            yscrollcommand=scrollbar.set
        )

        self.canvas.pack(
            side="left",
            fill="both",
            expand=True
        )

        scrollbar.pack(
            side="right",
            fill="y"
        )

        self.canvas.bind(
            "<MouseWheel>",
            self.mouse_scroll
        )

        # Show default message
        self.show_disaster()


    # =====================================================
    # UPDATE SCROLL
    # =====================================================

    def update_scroll(self, event):

        self.canvas.configure(
            scrollregion=self.canvas.bbox("all")
        )


    # =====================================================
    # RESIZE INFORMATION
    # =====================================================

    def resize_info(self, event):

        self.canvas.itemconfig(
            self.canvas_window,
            width=event.width
        )


    # =====================================================
    # MOUSE SCROLL
    # =====================================================

    def mouse_scroll(self, event):

        self.canvas.yview_scroll(
            int(-1 * (event.delta / 120)),
            "units"
        )


    # =====================================================
    # SHOW DISASTER
    # =====================================================

    def show_disaster(self, name=None):

        # Remove old information
        for item in self.info.winfo_children():
            item.destroy()

        # Reset scroll position
        self.canvas.yview_moveto(0)

        if name:

            tk.Label(
                self.info,
                text=name,
                font=("Arial", 20, "bold")
            ).pack(
                pady=(15, 8)
            )

            tk.Label(
                self.info,
                text="What is " + name + "?",
                font=("Arial", 15, "bold")
            ).pack(
                anchor="w",
                padx=25,
                pady=(5, 5)
            )

            tk.Label(
                self.info,
                text=disasters[name]["description"],
                font=("Arial", 11),
                wraplength=700,
                justify="left"
            ).pack(
                fill="x",
                padx=25,
                pady=(0, 5)
            )

            tk.Label(
                self.info,
                text=disasters[name]["description_source"],
                font=("Arial", 9, "italic"),
                wraplength=700,
                justify="left"
            ).pack(
                fill="x",
                padx=25,
                pady=(0, 15)
            )


            # =========================
            # TSUNAMI WARNING SIGNS
            # =========================

            if name == "Tsunami":

                tk.Label(
                    self.info,
                    text="Natural Warning Signs",
                    font=("Arial", 15, "bold")
                ).pack(
                    anchor="w",
                    padx=25,
                    pady=(5, 5)
                )

                for text in disasters[name]["Warning Signs"]:

                    tk.Label(
                        self.info,
                        text="• " + text,
                        font=("Arial", 11),
                        wraplength=700,
                        justify="left",
                        anchor="w"
                    ).pack(
                        fill="x",
                        padx=30,
                        pady=4
                    )

                tk.Label(
                    self.info,
                    text=disasters[name]["Warning_source"],
                    font=("Arial", 9, "italic"),
                    wraplength=700,
                    justify="left"
                ).pack(
                    fill="x",
                    padx=25,
                    pady=(2, 15)
                )


            # =========================
            # BEFORE / DURING / AFTER
            # =========================

            for part in ["Before", "During", "After"]:

                tk.Label(
                    self.info,
                    text=part + " a " + name,
                    font=("Arial", 15, "bold")
                ).pack(
                    anchor="w",
                    padx=25,
                    pady=(10, 5)
                )

                for text in disasters[name][part]:

                    tk.Label(
                        self.info,
                        text="• " + text,
                        font=("Arial", 11),
                        wraplength=700,
                        justify="left",
                        anchor="w"
                    ).pack(
                        fill="x",
                        padx=30,
                        pady=4
                    )

                tk.Label(
                    self.info,
                    text=disasters[name][part + "_source"],
                    font=("Arial", 9, "italic"),
                    wraplength=700,
                    justify="left"
                ).pack(
                    fill="x",
                    padx=25,
                    pady=(2, 10)
                )

        else:

            tk.Label(
                self.info,
                text="Select a disaster above to view its information.",
                font=("Arial", 12)
            ).pack(
                pady=40
            )


import tkinter as tk
from tkinter import ttk, messagebox


class MainApplication(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Emergency Reporting & Alert System")
        self.geometry("600x700")

        # Container frame to hold all screens
        container = tk.Frame(self)
        container.pack(side="top", fill="both", expand=True)
        container.grid_rowconfigure(0, weight=1)
        container.grid_columnconfigure(0, weight=1)

        self.frames = {}
        for PageClass in (HomeScreen, EmergencyReportScreen):
            page_name = PageClass.__name__
            frame = PageClass(parent=container, controller=self)
            self.frames[page_name] = frame
            frame.grid(row=0, column=0, sticky="nsew")

        self.show_frame("HomeScreen")

    def show_frame(self, page_name):
        frame = self.frames[page_name]
        frame.tkraise()


