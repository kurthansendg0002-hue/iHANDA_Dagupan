            column=1,
            pady=20
        )


        # =========================
        # NOTE
        # =========================

        tk.Label(
            self,
            text="For actual emergencies, contact the appropriate emergency authorities.",
            font=("Arial", 9)
        ).pack(
            pady=3
        )


        # =========================
        # FOOTER
        # =========================

        tk.Label(
            self,
            text="© iHANDA Dagupan 2026",
            font=("Arial", 9)
        ).pack(
            fill="x",
            side="bottom",
            pady=8
        )


    # =====================================================
    # SUBMIT REPORT
    # =====================================================

    def submit_report(self):

        name = self.name_entry.get()
        contact = self.contact_entry.get()
        location = self.location_entry.get()
        emergency = self.emergency_type.get()
        description = self.description_entry.get(
            "1.0",
            "end-1c"
        )

        if (
            name == ""
            or contact == ""
            or location == ""
            or emergency == ""
            or description == ""
        ):

            messagebox.showwarning(
                "Incomplete Information",
                "Please complete all required fields."
            )

            return

        messagebox.showinfo(
            "Emergency Report",
            "Emergency report submitted successfully."
        )


